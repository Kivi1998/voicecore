# SwiftFormat 配置（FND-003）
# 工具版本：swiftformat 0.62.x（本机 Homebrew 与 CI 使用同一主版本；brew 仅提供最新版）

--swiftversion 6.0

# 规则
--indent 4
--linebreaks lf
--maxwidth 120
--wraparguments before-first
--wrapcollections before-first
--closingparen balanced
--trimwhitespace always
# 与 SwiftLint sorted_imports 对齐：@testable 按模块名一起排序
--importgrouping alphabetized
# 与 SwiftLint trailing_comma（禁止尾逗号）对齐，避免两个工具互相打架
--trailing-commas never
# 与 SwiftLint opening_brace 对齐：多行条件的左花括号不换行
# hoistAwait 会把 async 自动闭包实参内的内层 await 错误上提（编译失败）
--disable wrapMultilineStatementBraces,hoistAwait

# 排除
--exclude **/.build,**/Package.resolved
