# VoiceCore 环境变量示例（FND-004）
# 本文件是模板，可以提交；真实密钥严禁写入本文件或任何已提交文件。
# 复制为 .env（已在 .gitignore）后填入本地开发值。

# —— 配置分层（优先级从高到低）——
# 1. 数据库应用设置（app_settings 表，用户在设置页的显式选择）
# 2. 环境变量（仅开发期覆盖；release 构建不读取）
# 3. 代码内默认值（本文件展示的值即默认值）

# 语音识别默认超时（秒）。长音频在此基础上按时长伸缩（编排层规则）。
VOICECORE_STT_TIMEOUT_SECONDS=60

# 改写最大输出 token。
VOICECORE_REWRITE_MAX_OUTPUT_TOKENS=1024

# 日志级别：debug / info / warning / error（release 默认 warning）。
VOICECORE_LOG_LEVEL=info

# 开发用提供商密钥：不采用环境变量传密钥——密钥一律经设置页写入
# provider_profiles.api_key（SQLite，0600 目录），读取只走 secrets(id:) 通道。
# 此处刻意不提供 VOICECORE_API_KEY 变量，防止密钥进入环境/日志/快照。
